{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WebhooksListResponse",
  "type": "object",
  "required": ["webhooks"],
  "properties": {
    "webhooks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "url", "triggers"],
        "properties": {
          "id": { "type": "string" },
          "url": { "type": "string" },
          "lat": { "type": "number" },
          "lon": { "type": "number" },
          "triggers": {
            "type": "array",
            "items": { "type": "string" }
          },
          "timezone": { "type": "string" },
          "active": { "type": "boolean" },
          "createdAt": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": true
}
