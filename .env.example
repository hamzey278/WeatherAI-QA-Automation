# WeatherAI API Configuration
WEATHER_API_KEY=wai_your_api_key_here
WEATHER_API_BASE_URL=https://api.weather-ai.co

# Performance and Timeout Configurations
API_TIMEOUT=10
PERFORMANCE_THRESHOLD_MS=3000

# Mock Server Settings (Set to true to force contract mock responses during CI/offline runs)
USE_MOCK_SERVER=false
